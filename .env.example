# Copy to .env and fill in at least ONE channel. More channels = harder to miss.

# --- What to watch -------------------------------------------------------
TARGET_DATE=2026-12-26
CHECK_INTERVAL_SECONDS=60
# How many checks in a row to keep alerting once tickets are live
ALERT_REPEATS=3

# --- ntfy (free, no account, easiest) ------------------------------------
# Install the "ntfy" app, subscribe to your topic. Pick a long random topic name.
NTFY_TOPIC=
# Optional: ntfy also forwards each alert to this address (free email channel)
NTFY_EMAIL=
# NTFY_SERVER=https://ntfy.sh

# --- Telegram ------------------------------------------------------------
# Create a bot with @BotFather; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pushover (one-time $5; emergency alerts repeat until you acknowledge) -
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- WhatsApp via CallMeBot (free; see callmebot.com to get an API key) ----
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Twilio SMS + phone CALL ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
TWILIO_CALL=1

# --- Discord webhook -----------------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Email via SMTP (e.g. Gmail app password; outbound SMTP may be blocked on Firebase, use NTFY_EMAIL there) -----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
